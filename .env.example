# Database (PostgreSQL with pgvector extension)
DATABASE_URL=postgres://demediator:demediator@localhost:5432/demediator

# Crawl4AI scraper (default port 11235)
SCRAPER_BASE_URL=http://localhost:11235

# Small LLM — used for classification, claim extraction, phantom matching, summaries
# Any OpenAI-compatible endpoint works (vLLM, Ollama, llama.cpp, LiteLLM, etc.)
SMALL_LLM_BASE_URL=http://localhost:8001/v1
SMALL_LLM_MODEL=your-small-model
SMALL_LLM_API_KEY=dummy

# Large LLM — used for edge fidelity analysis (source vs downstream comparison)
LARGE_LLM_BASE_URL=http://localhost:8003/v1
LARGE_LLM_MODEL=your-large-model
LARGE_LLM_API_KEY=dummy

# Embedding model — used for claim similarity / cross-source corroboration
EMBEDDING_BASE_URL=http://localhost:8002/v1
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_API_KEY=dummy

# Pipeline tuning (defaults shown — all optional)
# PIPELINE_MAX_DEPTH=5              # BFS depth through source chain
# PIPELINE_MAX_URLS=50              # Total URLs to scrape
# PIPELINE_MAX_URLS_PER_LEVEL=15    # URLs per BFS level
# PIPELINE_LLM_CONCURRENCY=5       # Concurrent LLM calls
# PIPELINE_MAX_PHANTOM_EDGES=15     # Max unverifiable source edges
# PIPELINE_MAX_PHANTOM_PER_PARENT=5
# PIPELINE_MAX_PHANTOM_DEPTH=1
